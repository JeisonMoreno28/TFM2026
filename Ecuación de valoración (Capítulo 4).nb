Cell[BoxData["\<\"Soluci\[OAcute]n exacta para Dj[tau]:\"\>"], "Print",
 CellChangeTimes->{3.9871180346411886`*^9, 3.988307245923258*^9, 
  3.9883074391144505`*^9},
 CellLabel->
  "Durante la evaluaci\[OAcute]n de \
In[270]:=",ExpressionUUID->"6062d9a7-9b9d-684c-886b-3041f2580c29"],

Cell[BoxData[
 FormBox[
  FractionBox[
   RowBox[{
    RowBox[{
     SqrtBox[
      RowBox[{
       RowBox[{"4", " ", "alpha", " ", "gamma"}], "-", 
       SuperscriptBox["beta", "2"]}]], " ", 
     RowBox[{"tan", "(", 
      RowBox[{
       RowBox[{
        FractionBox["1", "2"], " ", "tau", " ", 
        SqrtBox[
         RowBox[{
          RowBox[{"4", " ", "alpha", " ", "gamma"}], "-", 
          SuperscriptBox["beta", "2"]}]]}], "-", 
       RowBox[{
        SuperscriptBox["sec", 
         RowBox[{"-", "1"}]], "(", 
        RowBox[{"-", 
         FractionBox[
          RowBox[{"2", " ", 
           SqrtBox["alpha"], " ", 
           SqrtBox["gamma"]}], 
          SqrtBox[
           RowBox[{
            RowBox[{"4", " ", "alpha", " ", "gamma"}], "-", 
            SuperscriptBox["beta", "2"]}]]]}], ")"}]}], ")"}]}], "+", 
    "beta"}], 
   RowBox[{"2", " ", "gamma"}]], TraditionalForm]], "Output",
 CellChangeTimes->{3.987118034688053*^9, 3.988307245985777*^9, 
  3.9883074391144505`*^9},
 CellLabel->
  "Out[278]//TraditionalForm=",ExpressionUUID->"83c6bff4-eafb-e843-9326-\
cf324ff95c0d"],

Cell[BoxData["\<\"Soluci\[OAcute]n exacta para Cj[tau]:\"\>"], "Print",
 CellChangeTimes->{3.9871180346411886`*^9, 3.988307245923258*^9, 
  3.988307439130068*^9},
 CellLabel->
  "Durante la evaluaci\[OAcute]n de \
In[270]:=",ExpressionUUID->"59b3eb88-74e6-1042-bef3-c97537d9195b"],

Cell[BoxData[
 FormBox[
  FractionBox[
   RowBox[{"lambda", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"2", " ", 
        RowBox[{"log", "(", 
         RowBox[{"sin", "(", 
          RowBox[{
           RowBox[{
            FractionBox["1", "2"], " ", "tau", " ", 
            SqrtBox[
             RowBox[{
              RowBox[{"4", " ", "alpha", " ", "gamma"}], "-", 
              SuperscriptBox["beta", "2"]}]]}], "-", 
           RowBox[{
            SuperscriptBox["csc", 
             RowBox[{"-", "1"}]], "(", 
            FractionBox[
             RowBox[{"2", " ", 
              SqrtBox["alpha"], " ", 
              SqrtBox["gamma"]}], 
             SqrtBox[
              RowBox[{
               RowBox[{"4", " ", "alpha", " ", "gamma"}], "-", 
               SuperscriptBox["beta", "2"]}]]], ")"}]}], ")"}], ")"}]}]}], "+", 
      RowBox[{"2", " ", 
       RowBox[{"log", "(", 
        RowBox[{"-", 
         FractionBox[
          SqrtBox[
           RowBox[{
            RowBox[{"4", " ", "alpha", " ", "gamma"}], "-", 
            SuperscriptBox["beta", "2"]}]], 
          RowBox[{"2", " ", 
           SqrtBox["alpha"], " ", 
           SqrtBox["gamma"]}]]}], ")"}]}], "+", 
      RowBox[{"beta", " ", "tau"}]}], ")"}]}], 
   RowBox[{"2", " ", "gamma"}]], TraditionalForm]], "Output",
 CellChangeTimes->{3.987118034688053*^9, 3.988307245985777*^9, 
  3.988307439145689*^9},
 CellLabel->
  "Out[280]//TraditionalForm=",ExpressionUUID->"97e9086e-8de4-9d4f-9c86-\
8f34c3356ed1"]
