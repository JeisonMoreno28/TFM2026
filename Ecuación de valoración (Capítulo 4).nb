        SuperscriptBox["Dj", "\[Prime]",
         MultilineFunction->None], "(", "tau", ")"}], "+", 
       RowBox[{"gamma", " ", 
        SuperscriptBox[
         RowBox[{"Dj", "(", "tau", ")"}], "2"]}]}], ")"}]}], "-", 
