Cell[CellGroupData[{

Cell[TextData[StyleBox["Soluci\[OAcute]n del sistema EDO para C y D", \
"Subtitle"]], "Section",
 CellChangeTimes->{{3.987117989833745*^9, 3.9871180139311123`*^9}, 
   3.988307262823965*^9},ExpressionUUID->"60a3e26c-bf43-4c8d-8353-\
b06acf567e00"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "Cj", ",", "Dj", ",", "tau", ",", "alpha", ",", "beta", ",", "gamma", ",",
      "lambda"}], "]"}], ";"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Definimos", " ", "el", " ", "sistema", " ", "de", " ", "ecuaciones", " ", 
    "diferenciales"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"eqD", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Dj", "'"}], "[", "tau", "]"}], "\[Equal]", 
    RowBox[{"alpha", "-", 
     RowBox[{"beta", "*", 
      RowBox[{"Dj", "[", "tau", "]"}]}], "+", 
     RowBox[{"gamma", "*", 
      RowBox[{
       RowBox[{"Dj", "[", "tau", "]"}], "^", "2"}]}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"eqC", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"Cj", "'"}], "[", "tau", "]"}], "\[Equal]", 
     RowBox[{"lambda", "*", 
      RowBox[{"Dj", "[", "tau", "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
  "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Definimos", " ", "las", " ", "condiciones", " ", "iniciales", " ", "en", " ",
     "el", " ", "vencimiento", " ", 
    RowBox[{"(", 
     RowBox[{"tau", "=", "0"}], ")"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"condIniciales", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"Dj", "[", "0", "]"}], "\[Equal]", "0"}], ",", 
      RowBox[{
       RowBox[{"Cj", "[", "0", "]"}], "\[Equal]", "0"}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Resolvemos", " ", "el", " ", "sistema", " ", "anal\[IAcute]ticamente"}], 
   " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"solucion", "=", 
    RowBox[{"DSolve", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"eqD", ",", "eqC", ",", "condIniciales"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Cj", "[", "tau", "]"}], ",", 
        RowBox[{"Dj", "[", "tau", "]"}]}], "}"}], ",", "tau"}], "]"}]}], 
   ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Extraemos", " ", "y", " ", "simplificamos", " ", "las", " ", 
    "soluciones"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"solDj", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"Dj", "[", "tau", "]"}], "/.", 
     RowBox[{"solucion", "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"solCj", "=", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{"Cj", "[", "tau", "]"}], "/.", 
      RowBox[{"solucion", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"Mostramos", " ", "los", " ", "resultados"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<Soluci\[OAcute]n exacta para Dj[tau]:\>\"", "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"solDj", "//", "TraditionalForm"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<Soluci\[OAcute]n exacta para Cj[tau]:\>\"", "]"}], 
  ";"}], "\n", 
 RowBox[{"solCj", "//", "TraditionalForm"}]}], "Input",
 CellChangeTimes->{{3.987118017972192*^9, 3.9871180179841394`*^9}, {
  3.9883072085022697`*^9, 3.9883072249825478`*^9}, {3.9883073823121834`*^9, 
  3.988307382608986*^9}},
 CellLabel->
  "In[270]:=",ExpressionUUID->"6d351ace-1738-4c3c-b32c-0650b17b82b4"],

Cell[BoxData[
 TemplateBox[{
  "Solve", "incnst", 
   "\"Inconsistent or redundant transcendental equation. After reduction, the \
bad equation is \\!\\(\\*RowBox[{RowBox[{\\\"-\\\", SuperscriptBox[\\\"beta\\\
\", \\\"2\\\"]}], \\\"+\\\", RowBox[{\\\"4\\\", \\\" \\\", \\\"alpha\\\", \
\\\" \\\", \\\"gamma\\\"}], \\\"-\\\", RowBox[{\\\"4\\\", \\\" \\\", \
\\\"alpha\\\", \\\" \\\", \\\"gamma\\\", \\\" \\\", SuperscriptBox[RowBox[{\\\
\"Cos\\\", \\\"[\\\", RowBox[{FractionBox[\\\"1\\\", \\\"2\\\"], \\\" \\\", \
SqrtBox[RowBox[{RowBox[{\\\"Times\\\", \\\"[\\\", RowBox[{\\\"\[LeftSkeleton]\
\\\", \\\"2\\\", \\\"\[RightSkeleton]\\\"}], \\\"]\\\"}], \\\"+\\\", RowBox[{\
\\\"Times\\\", \\\"[\\\", RowBox[{\\\"\[LeftSkeleton]\\\", \\\"3\\\", \\\"\
\[RightSkeleton]\\\"}], \\\"]\\\"}]}]], \\\" \\\", \
TemplateBox[List[\\\"1\\\"], \\\"C\\\"]}], \\\"]\\\"}], \\\"2\\\"]}]}]\\) == \
0.\"", 2, 274, 9, 34683989974619816055, "Local"},
  "MessageTemplate",
  BaseStyle->"MSG"]], "Message",
 CellChangeTimes->{3.9871180323892035`*^9, 3.9883072436113396`*^9, 
  3.988307438880129*^9},
 CellLabel->
  "Durante la evaluaci\[OAcute]n de \
In[270]:=",ExpressionUUID->"e6272bbb-82ab-bc4b-b72f-73c9b98de0cf"],

Cell[BoxData[
 TemplateBox[{
  "Solve", "incnst", 
   "\"Inconsistent or redundant transcendental equation. After reduction, the \
bad equation is \\!\\(\\*RowBox[{RowBox[{RowBox[{\\\"-\\\", \\\"4\\\"}], \\\" \
\\\", \\\"alpha\\\"}], \\\"+\\\", FractionBox[SuperscriptBox[\\\"beta\\\", \\\
\"2\\\"], \\\"gamma\\\"], \\\"+\\\", RowBox[{\\\"4\\\", \\\" \\\", \
\\\"alpha\\\", \\\" \\\", SuperscriptBox[RowBox[{\\\"Cos\\\", \\\"[\\\", \
RowBox[{FractionBox[\\\"1\\\", \\\"2\\\"], \\\" \\\", \
SqrtBox[RowBox[{RowBox[{\\\"Times\\\", \\\"[\\\", RowBox[{\\\"\[LeftSkeleton]\
\\\", \\\"2\\\", \\\"\[RightSkeleton]\\\"}], \\\"]\\\"}], \\\"+\\\", RowBox[{\
\\\"Times\\\", \\\"[\\\", RowBox[{\\\"\[LeftSkeleton]\\\", \\\"3\\\", \\\"\
\[RightSkeleton]\\\"}], \\\"]\\\"}]}]], \\\" \\\", \
TemplateBox[List[\\\"1\\\"], \\\"C\\\"]}], \\\"]\\\"}], \\\"2\\\"]}]}]\\) == \
0.\"", 2, 274, 10, 34683989974619816055, "Local"},
  "MessageTemplate",
  BaseStyle->"MSG"]], "Message",
 CellChangeTimes->{3.9871180323892035`*^9, 3.9883072436113396`*^9, 
  3.9883074389269943`*^9},
 CellLabel->
  "Durante la evaluaci\[OAcute]n de \
In[270]:=",ExpressionUUID->"84431a41-ff65-994b-b0b1-a5e4546694f7"],

Cell[BoxData[
 TemplateBox[{
  "DSolve", "ifun", 
   "\"Inverse functions are being used by DSolve, so some solutions may not \
be found.\"", 2, 274, 11, 34683989974619816055, "Local"},
  "MessageTemplate",
  BaseStyle->"MSG"]], "Message",
 CellChangeTimes->{3.9871180323892035`*^9, 3.9883072436113396`*^9, 
