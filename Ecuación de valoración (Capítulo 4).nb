 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"a", " ", 
     RowBox[{"Dj", "(", "tau", ")"}]}], "+", 
    RowBox[{"v", " ", 
     RowBox[{"(", 
      RowBox[{"alpha", "-", 
       RowBox[{"beta", " ", 
        RowBox[{"Dj", "(", "tau", ")"}]}], "-", 
