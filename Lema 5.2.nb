  RowBox[{"(*", " ", 
   RowBox[{"Resolver", " ", "Ecuaci\[OAcute]n", " ", "c", 
    RowBox[{"(", "tau", ")"}], " ", 
    RowBox[{"(", 
     RowBox[{"Integraci\[OAcute]n", " ", "directa"}], ")"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Sustituimos", " ", "las", " ", "soluciones", " ", "de", " ", "d", " ", 
    "y", " ", "e", " ", "en", " ", "la", " ", "derivada", " ", "de", " ", 
    "c"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"rhsC", "=", 
     RowBox[{
      RowBox[{"kappa", "*", "theta", "*", 
       RowBox[{"d", "[", "tau", "]"}]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"eta", "-", 
         RowBox[{
          RowBox[{"sigmaR", "^", "2"}], "*", 
          RowBox[{"bTilde", "[", "tau", "]"}]}]}], ")"}], "*", 
       RowBox[{"e", "[", "tau", "]"}]}], "+", 
      RowBox[{
       RowBox[{"1", "/", "2"}], "*", 
       RowBox[{"sigmaR", "^", "2"}], "*", 
       RowBox[{
        RowBox[{"e", "[", "tau", "]"}], "^", "2"}]}]}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"solC", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"DSolve", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"c", "'"}], "[", "tau", "]"}], "\[Equal]", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"rhsC", "/.", "solD"}], "/.", "solE"}], ")"}]}], ",", 
            RowBox[{
             RowBox[{"c", "[", "0", "]"}], "\[Equal]", "0"}]}], "}"}], ",", 
          RowBox[{"c", "[", "tau", "]"}], ",", "tau"}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}], ",", 
       RowBox[{"TimeConstraint", "\[Rule]", "30"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Soluci\[OAcute]n c(tau):\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{
       RowBox[{"c", "[", "tau", "]"}], "/.", "solC"}], "]"}], "]"}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{3.9857262862875004`*^9, 3.985726286710054*^9}, {
  3.988294530323616*^9, 3.988294612961462*^9}, {3.988303743967905*^9, 
