Cell[BoxData[
 TemplateBox[{
   RowBox[{"(", 
     RowBox[{
       FractionBox[
        RowBox[{"\[ImaginaryI]", " ", 
          RowBox[{"(", 
            RowBox[{"1", "-", 
              SuperscriptBox["\[ExponentialE]", 
               RowBox[{
                 RowBox[{"-", "gamma"}], " ", 
                 RowBox[{"K", "[", "1", "]"}]}]]}], ")"}], " ", "eta", " ", 
          "u"}], "gamma"], "-", 
       FractionBox[
        RowBox[{
          SuperscriptBox["\[ExponentialE]", 
           RowBox[{
             RowBox[{"-", "2"}], " ", "gamma", " ", 
             RowBox[{"K", "[", "1", "]"}]}]], " ", 
          SuperscriptBox[
           RowBox[{"(", 
             RowBox[{
               RowBox[{"-", "1"}], "+", 
               SuperscriptBox["\[ExponentialE]", 
                RowBox[{"gamma", " ", 
                  RowBox[{"K", "[", "1", "]"}]}]]}], ")"}], "2"], " ", 
          SuperscriptBox["sigmaR", "2"], " ", 
          SuperscriptBox["u", "2"]}], 
        RowBox[{"2", " ", 
          SuperscriptBox["gamma", "2"]}]], "+", 
       FractionBox[
        RowBox[{"kappa", " ", "theta", " ", 
          RowBox[{"(", 
            RowBox[{"kappa", "-", 
              
              RowBox[{"\[ImaginaryI]", " ", "rho", " ", "sigmaV", " ", 
                "u"}]}], ")"}]}], 
        SuperscriptBox["sigmaV", "2"]], "-", 
       FractionBox[
        RowBox[{"\[ImaginaryI]", " ", 
          SuperscriptBox["\[ExponentialE]", 
           RowBox[{
             RowBox[{"-", "gamma"}], " ", 
             RowBox[{"K", "[", "1", "]"}]}]], " ", 
          RowBox[{"(", 
            RowBox[{
              RowBox[{"-", "1"}], "+", 
              SuperscriptBox["\[ExponentialE]", 
               RowBox[{"gamma", " ", 
                 RowBox[{"K", "[", "1", "]"}]}]]}], ")"}], " ", 
          SuperscriptBox["sigmaR", "2"], " ", "u", " ", 
          RowBox[{
            FractionBox[
             RowBox[{"1", "-", 
               SuperscriptBox["\[ExponentialE]", 
                RowBox[{
                  RowBox[{"-", "gamma"}], " ", 
                  RowBox[{"K", "[", "1", "]"}]}]]}], "gamma"], "[", 
            RowBox[{"K", "[", "1", "]"}], "]"}]}], "gamma"], "+", 
       RowBox[{
         FractionBox["1", 
          SuperscriptBox["sigmaV", "2"]], 
         RowBox[{"kappa", " ", "theta", " ", 
           SqrtBox[
            RowBox[{
              RowBox[{"-", 
                SuperscriptBox["kappa", "2"]}], "+", 
              
              RowBox[{"2", " ", "\[ImaginaryI]", " ", "kappa", " ", "rho", 
                " ", "sigmaV", " ", "u"}], "+", 
              RowBox[{
                SuperscriptBox["sigmaV", "2"], " ", "u", " ", 
                RowBox[{"(", 
                  RowBox[{
                    RowBox[{"-", "\[ImaginaryI]"}], "+", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"-", "1"}], "+", 
                    SuperscriptBox["rho", "2"]}], ")"}], " ", "u"}]}], 
                  ")"}]}]}]], " ", 
           RowBox[{"Tan", "[", 
             RowBox[{
               RowBox[{"ArcTan", "[", 
                 FractionBox[
                  RowBox[{
                    RowBox[{"-", "kappa"}], "+", 
                    
                    RowBox[{
                    "\[ImaginaryI]", " ", "rho", " ", "sigmaV", " ", "u"}]}], 
                  SqrtBox[
                   RowBox[{
                    RowBox[{"-", 
                    SuperscriptBox["kappa", "2"]}], "+", 
                    
                    RowBox[{
                    "2", " ", "\[ImaginaryI]", " ", "kappa", " ", "rho", " ", 
                    "sigmaV", " ", "u"}], "+", 
                    RowBox[{
                    SuperscriptBox["sigmaV", "2"], " ", "u", " ", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"-", "\[ImaginaryI]"}], "+", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"-", "1"}], "+", 
                    SuperscriptBox["rho", "2"]}], ")"}], " ", "u"}]}], 
                    ")"}]}]}]]], "]"}], "+", 
               RowBox[{
                 FractionBox["1", "2"], " ", 
                 SqrtBox[
                  RowBox[{
                    RowBox[{"-", 
                    SuperscriptBox["kappa", "2"]}], "+", 
                    
                    RowBox[{
                    "2", " ", "\[ImaginaryI]", " ", "kappa", " ", "rho", " ", 
                    "sigmaV", " ", "u"}], "+", 
                    RowBox[{
                    SuperscriptBox["sigmaV", "2"], " ", "u", " ", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"-", "\[ImaginaryI]"}], "+", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"-", "1"}], "+", 
                    SuperscriptBox["rho", "2"]}], ")"}], " ", "u"}]}], 
                    ")"}]}]}]], " ", 
                 RowBox[{"K", "[", "1", "]"}]}]}], "]"}]}]}]}], ")"}], 
   RowBox[{"K", "[", "1", "]"}], "0", "tau"},
  "InactiveIntegrate",
